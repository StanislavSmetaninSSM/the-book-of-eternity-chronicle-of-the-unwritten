{
  "manifest_version": 3,
  "name": "Book of Eternity Local Game Bridge",
  "version": "0.1.0",
  "description": "Manually approved, narrowly scoped local mailbox tools for Book of Eternity on Arena.ai.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Book of Eternity Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://arena.ai/*", "https://www.arena.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
