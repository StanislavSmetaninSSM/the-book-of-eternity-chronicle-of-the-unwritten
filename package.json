{
  "name": "book-of-eternity-chronicle-of-the-unwritten",
  "private": true,
  "version": "0.9.14",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "arena:preview": "npm run build && vite preview --host 0.0.0.0",
    "relay:watch": "node scripts/arena-gm-mailbox-watcher.mjs",
    "test:relay": "node --test scripts/arena-gm-relay.integration.test.mjs",
    "test": "node --test scripts/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "e2e:fixtures": "node scripts/make-e2e-fixtures.mjs",
    "sandbox:chromium": "node scripts/prepare-sandbox-chromium.mjs",
    "sandbox:setup": "npm i --no-save @sparticuz/chromium puppeteer-core && node scripts/prepare-sandbox-chromium.mjs",
    "test:e2e:sandbox": "npm run build && playwright test --config=playwright.sandbox.config.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@google/genai": "^1.10.0",
    "@heroicons/react": "^2.1.5",
    "dompurify": "^3.4.17",
    "marked": "^16.1.1",
    "react": "^19.0.0-rc.0",
    "react-dom": "^19.0.0-rc.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "overrides": {
    "postcss-selector-parser": "6.1.5"
  }
}
